#!/usr/bin/env python3
"""Guided backup, restore and flashing of a split RP2040 keyboard.

Waits for each half to enter the bootloader, recognises it by its RP2040 flash
ID (listed in kbflash.json), drives picotool and reboots it. No keypress is
needed mid-run, since the keyboard is down while a half is in the bootloader.
A backup can only be restored to the half it came from.

  kbflash backup                 full-flash image of both halves
  kbflash restore DIR            write a backup back, each image to its own half
  kbflash flash FIRMWARE.uf2     flash the same firmware to both halves
  kbflash drill                  backup, then restore it, to prove the hatch works
"""

import argparse
import datetime
import hashlib
import json
import os
import shutil
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path

BOOTSEL_ID = ("2e8a", "0003")

SYSFS = Path(os.environ.get("KBFLASH_SYSFS", "/sys"))
PICOTOOL = os.environ.get("KBFLASH_PICOTOOL", "picotool")
BACKUP_ROOT = Path(os.environ.get("KBFLASH_BACKUPS", Path.home() / "git/keyboard/backups"))
CONFIG = Path(os.environ.get("KBFLASH_CONFIG", Path(__file__).resolve().parent.parent / "kbflash.json"))

HINT_AFTER = 15
BOOTSEL_TIMEOUT = 300
APP_TIMEOUT = 30
ACCESS_TIMEOUT = 10

# QMK on this board assumes 2 MB of flash: firmware sits at the start and the
# wear-leveled settings at the end of those 2 MB. Erasing this range clears
# everything firmware writes, in ~30 s instead of minutes for all 16 MB.
FIRMWARE_REGION = (0x10000000, 0x10200000)

UF2_BLOCK = 512
UF2_HEADER = struct.Struct("<IIIIIIII")


class Abort(Exception):
    pass


def say(msg=""):
    print(msg, flush=True)


def confirm(msg):
    try:
        return input(f"{msg} [y/N] ").strip().lower() == "y"
    except EOFError:
        raise Abort("input closed")


def load_config():
    """kbflash.json: {"app_vendor": "8d1d", "halves": {"left": {"flash_id", "bootmagic"}, ...}}"""
    config = json.loads(CONFIG.read_text())
    config["halves"] = {side: dict(h, flash_id=h["flash_id"].upper()) for side, h in config["halves"].items()}
    return config


def usb_devices():
    root = SYSFS / "bus/usb/devices"
    devices = []
    for d in root.glob("*"):
        try:
            vid = (d / "idVendor").read_text().strip()
            pid = (d / "idProduct").read_text().strip()
        except OSError:
            continue
        devices.append({"vid": vid, "pid": pid})
    return devices


def bootsel_devices():
    return [d for d in usb_devices() if (d["vid"], d["pid"]) == BOOTSEL_ID]


def wait_until(cond, timeout, hint=None):
    start = time.monotonic()
    hinted = False
    while time.monotonic() - start < timeout:
        result = cond()
        if result:
            return result
        if hint and not hinted and time.monotonic() - start > HINT_AFTER:
            say(hint)
            hinted = True
        time.sleep(0.5)
    return None


def picotool(*args, fid=None, capture=False):
    cmd = [PICOTOOL, *args]
    if fid:
        cmd += ["--ser", fid]
    if capture:
        res = subprocess.run(cmd, capture_output=True, text=True)
    else:
        res = subprocess.run(cmd)
    if res.returncode != 0:
        detail = (res.stderr or "").strip() if capture else ""
        raise Abort(f"picotool {args[0]} failed (exit {res.returncode}) {detail}")
    return res.stdout if capture else None


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def flash_id():
    """Flash ID of the one half in BOOTSEL; picotool --ser matches this on RP2040.

    Retries because udev grants access a moment after the device appears.
    """
    subprocess.run(["udevadm", "settle", "-t", "5"], capture_output=True)
    deadline = time.monotonic() + ACCESS_TIMEOUT
    while time.monotonic() < deadline:
        res = subprocess.run([PICOTOOL, "info", "-d"], capture_output=True, text=True)
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                key, _, value = line.strip().partition(":")
                if key == "flash id":
                    return value.strip().removeprefix("0x").upper()
            raise Abort("picotool info -d did not report a flash id")
        time.sleep(0.5)
    raise Abort("picotool cannot access the half in bootloader (permissions? see 60-picotool.rules)")


def reboot(fid, app_vendor):
    picotool("reboot", "-a", fid=fid)
    if not wait_until(lambda: not bootsel_devices(), APP_TIMEOUT):
        raise Abort("device stayed in bootloader mode after reboot")
    if not wait_until(lambda: any(d["vid"] == app_vendor for d in usb_devices()), APP_TIMEOUT):
        say("Warning: keyboard not seen on USB after reboot")


def each_half(config, sides, action, ids=None, finish=True):
    """Run action(side, fid) on each half as it shows up in the bootloader.

    ids maps side -> flash ID (default: kbflash.json). Halves are recognised
    by flash ID, so they can come in any order; one not in this run is
    rebooted unchanged.
    """
    ids = ids or {side: h["flash_id"] for side, h in config["halves"].items()}
    by_id = {fid: side for side, fid in ids.items()}
    pending = list(sides)
    say(f"USB cable in {pending[0].upper()} half, double-tap its reset button")
    last = None
    while pending:
        nxt = pending[0]
        hint = (f"Not detected. Or: unplug USB, hold {config['halves'][nxt]['bootmagic']} "
                f"on the {nxt.upper()} half, plug it in")
        found = wait_until(bootsel_devices, BOOTSEL_TIMEOUT, hint)
        if not found:
            raise Abort("bootloader did not appear")
        if len(found) > 1:
            raise Abort("more than one device in bootloader mode")
        fid = flash_id()
        side = by_id.get(fid)
        if side is None:
            raise Abort(f"unknown half, flash ID {fid}; add it to {CONFIG.name}")
        if side not in pending:
            say(f"{side.upper()} half is not pending, rebooting it unchanged")
            reboot(fid, config["app_vendor"])
            continue
        say(f"{side.upper()} half:")
        action(side, fid)
        reboot(fid, config["app_vendor"])
        pending.remove(side)
        last = side
        if pending:
            say(f"Move USB cable to {pending[0].upper()} half, double-tap its reset button")
    if not finish:
        return
    if last != "left":
        say("Done. Move USB cable back to LEFT half")
    else:
        say("Done")


def sparse_uf2(image, out):
    """Copy a UF2 without its blank (all 0xFF) blocks; returns blocks kept.

    A full-flash backup is 16 MB, nearly all blank. Writing only the data
    blocks after an erase gives the same flash in seconds.
    """
    data = image.read_bytes()
    blocks = []
    for i in range(0, len(data), UF2_BLOCK):
        block = data[i:i + UF2_BLOCK]
        size = UF2_HEADER.unpack_from(block)[4]
        if block[32:32 + size] != b"\xff" * size:
            blocks.append(bytearray(block))
    for n, block in enumerate(blocks):
        start0, start1, flags, addr, size, _, _, family = UF2_HEADER.unpack_from(block)
        UF2_HEADER.pack_into(block, 0, start0, start1, flags, addr, size, n, len(blocks), family)
    out.write_bytes(b"".join(blocks))
    return len(blocks)


def erase_firmware_region(fid):
    say("Erasing ...")
    start, end = FIRMWARE_REGION
    picotool("erase", "-r", hex(start), hex(end), fid=fid)


def parse_sides(value):
    return [s.strip() for s in value.split(",") if s.strip()]


def check_sides(config, sides):
    unknown = [s for s in sides if s not in config["halves"]]
    if unknown:
        raise Abort(f"unknown side {', '.join(unknown)}; {CONFIG.name} has {', '.join(config['halves'])}")


def do_backup(config, sides, label=None, root=BACKUP_ROOT, finish=True):
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    out = root / (f"{stamp}-{label}" if label else stamp)
    out.mkdir(parents=True)
    manifest = {"created": stamp, "sides": {}}
    say(f"Backup to {out}")

    def backup(side, fid):
        (out / f"{side}-info.txt").write_text(picotool("info", "-a", fid=fid, capture=True))
        image = out / f"{side}.uf2"
        say("Reading flash ...")
        picotool("save", "-a", "-v", str(image), fid=fid)
        manifest["sides"][side] = {"file": image.name, "sha256": sha256(image), "flash_id": fid}
        (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")

    each_half(config, sides, backup, finish=finish)
    return out


def do_restore(config, backup, sides):
    manifest = json.loads((backup / "manifest.json").read_text())
    missing = [s for s in sides if s not in manifest["sides"]]
    if missing:
        raise Abort(f"backup has no image for {', '.join(missing)}")
    for side in sides:
        entry = manifest["sides"][side]
        if sha256(backup / entry["file"]) != entry["sha256"]:
            raise Abort(f"{backup / entry['file']} does not match its recorded checksum")
    say(f"Restore from {backup}")

    def restore(side, fid):
        image = backup / manifest["sides"][side]["file"]
        with tempfile.TemporaryDirectory() as tmp:
            sparse = Path(tmp) / image.name
            sparse_uf2(image, sparse)
            erase_firmware_region(fid)
            say(f"Writing {image.name} ...")
            picotool("load", "-v", str(sparse), fid=fid)

    each_half(config, sides, restore, ids={s: e["flash_id"] for s, e in manifest["sides"].items()})


def cmd_backup(config, args):
    do_backup(config, args.sides, args.label)


def cmd_restore(config, args):
    do_restore(config, Path(args.backup).expanduser(), args.sides)


def cmd_flash(config, args):
    image = Path(args.firmware).expanduser()
    if not image.is_file():
        raise Abort(f"{image} not found")
    if set(args.sides) != set(config["halves"]):
        if not confirm("Halves must run the same firmware. Flash only " + ", ".join(args.sides) + "?"):
            raise Abort("cancelled")
    say(f"Flash {image.name}" + (" (erasing stored settings)" if args.erase else ""))

    def flash(side, fid):
        if args.erase:
            erase_firmware_region(fid)
        say(f"Writing {image.name} ...")
        picotool("load", "-v", str(image), fid=fid)

    each_half(config, args.sides, flash)


def cmd_drill(config, args):
    sides = list(config["halves"])
    backup = do_backup(config, sides, "drill", finish=False)
    # restore starts with the half the cable is already in
    do_restore(config, backup, sides[::-1])
    say(f"Drill passed: {backup}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    sides_help = "comma-separated, default all halves in kbflash.json"

    p = sub.add_parser("backup", help="full-flash image of each half")
    p.add_argument("--sides", type=parse_sides, help=sides_help)
    p.add_argument("--label", help="suffix for the backup directory")
    p.set_defaults(func=cmd_backup)

    p = sub.add_parser("restore", help="write a backup back to its halves")
    p.add_argument("backup", help="backup directory (contains manifest.json)")
    p.add_argument("--sides", type=parse_sides, help=sides_help)
    p.set_defaults(func=cmd_restore)

    p = sub.add_parser("flash", help="flash one firmware image to both halves")
    p.add_argument("firmware", help=".uf2 firmware file")
    p.add_argument("--sides", type=parse_sides, help=sides_help)
    p.add_argument("--erase", action="store_true", help="erase the firmware region first, clearing stored settings")
    p.set_defaults(func=cmd_flash)

    p = sub.add_parser("drill", help="backup then restore, to prove recovery works")
    p.set_defaults(func=cmd_drill)

    args = parser.parse_args()
    if not shutil.which(PICOTOOL):
        sys.exit(f"kbflash: {PICOTOOL} not found")
    try:
        config = load_config()
        if hasattr(args, "sides"):
            args.sides = args.sides or list(config["halves"])
            check_sides(config, args.sides)
        args.func(config, args)
    except Abort as e:
        say(f"\nkbflash: stopped: {e}")
        if bootsel_devices():
            say("A half is still in bootloader (safe). Bring it back: picotool reboot, or kbflash restore DIR")
        sys.exit(1)
    except KeyboardInterrupt:
        say("\nkbflash: interrupted")
        if bootsel_devices():
            say("A half is still in bootloader (safe). Bring it back: picotool reboot, or kbflash restore DIR")
        sys.exit(130)


if __name__ == "__main__":
    main()
