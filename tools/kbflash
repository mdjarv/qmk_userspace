#!/usr/bin/env python3
"""Guided backup, restore and flashing of a split RP2040 keyboard.

Walks through each half in turn: tells you where the USB cable goes and when
to enter the bootloader, then drives picotool. Each half is identified by its
RP2040 flash ID, so a backup can only be restored to the half it came from.

  kbflash backup                 full-flash image of both halves
  kbflash restore DIR            write a backup back, each image to its own half
  kbflash flash FIRMWARE.uf2     flash the same firmware to both halves
  kbflash drill                  backup, then restore it, to prove the hatch works
  kbflash vial-dump OUT.vil      save the live Vial layout (Vial firmware only)
"""

import argparse
import datetime
import hashlib
import json
import os
import shutil
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path

BOOTSEL_ID = ("2e8a", "0003")
APP_VENDOR = "8d1d"  # splitkb.com
SIDES = {
    # bootmagic key: inner top-row key, held while plugging in that half
    "left": {"bootmagic": '"5"'},
    "right": {"bootmagic": '"6"'},
}

SYSFS = Path(os.environ.get("KBFLASH_SYSFS", "/sys"))
PICOTOOL = os.environ.get("KBFLASH_PICOTOOL", "picotool")
BACKUP_ROOT = Path(os.environ.get("KBFLASH_BACKUPS", Path.home() / "git/keyboard/backups"))
TOOLS_DIR = Path(__file__).resolve().parent

HINT_AFTER = 15
BOOTSEL_TIMEOUT = 180
APP_TIMEOUT = 30
ACCESS_TIMEOUT = 10

# QMK on this board assumes 2 MB of flash: firmware sits at the start and the
# wear-leveled settings at the end of those 2 MB. Erasing this range clears
# everything firmware writes, in ~30 s instead of minutes for all 16 MB.
FIRMWARE_REGION = (0x10000000, 0x10200000)

UF2_BLOCK = 512
UF2_HEADER = struct.Struct("<IIIIIIII")


class Abort(Exception):
    pass


def say(msg=""):
    print(msg, flush=True)


def prompt(msg):
    try:
        input(f"{msg} [Enter] ")
    except EOFError:
        raise Abort("input closed")


def confirm(msg):
    try:
        return input(f"{msg} [y/N] ").strip().lower() == "y"
    except EOFError:
        raise Abort("input closed")


def usb_devices():
    root = SYSFS / "bus/usb/devices"
    devices = []
    for d in root.glob("*"):
        try:
            vid = (d / "idVendor").read_text().strip()
            pid = (d / "idProduct").read_text().strip()
        except OSError:
            continue
        devices.append({"vid": vid, "pid": pid})
    return devices


def bootsel_devices():
    return [d for d in usb_devices() if (d["vid"], d["pid"]) == BOOTSEL_ID]


def app_present():
    return any(d["vid"] == APP_VENDOR for d in usb_devices())


def wait_until(cond, timeout, hint=None):
    start = time.monotonic()
    hinted = False
    while time.monotonic() - start < timeout:
        result = cond()
        if result:
            return result
        if hint and not hinted and time.monotonic() - start > HINT_AFTER:
            say(hint)
            hinted = True
        time.sleep(0.5)
    return None


def picotool(*args, fid=None, capture=False):
    cmd = [PICOTOOL, *args]
    if fid:
        cmd += ["--ser", fid]
    if capture:
        res = subprocess.run(cmd, capture_output=True, text=True)
    else:
        res = subprocess.run(cmd)
    if res.returncode != 0:
        detail = (res.stderr or "").strip() if capture else ""
        raise Abort(f"picotool {args[0]} failed (exit {res.returncode}) {detail}")
    return res.stdout if capture else None


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def enter_bootsel(side, expect_id=None):
    """Guide one half into BOOTSEL and return its flash ID."""
    S = side.upper()
    waiting = bootsel_devices()
    if len(waiting) > 1:
        raise Abort("more than one device in bootloader mode")
    if waiting:
        # e.g. a half left in the bootloader by an earlier failed run
        fid = flash_id()
        if expect_id and fid != expect_id:
            raise Abort(f"half in bootloader is not the {side} half of this backup")
        if confirm(f"A half is already in bootloader. Is it {S}?"):
            return fid
        raise Abort("reboot it first (picotool reboot)")

    while True:
        prompt(f"USB cable in {S} half")
        say(f"Double-tap reset button on {S} half")
        hint = f"Not detected. Or: unplug USB, hold {SIDES[side]['bootmagic']}, plug in"
        found = wait_until(bootsel_devices, BOOTSEL_TIMEOUT, hint)
        if not found:
            raise Abort("bootloader did not appear")
        if len(found) > 1:
            raise Abort("more than one device in bootloader mode")
        fid = flash_id()
        if expect_id and fid != expect_id:
            say(f"Wrong half, not {S}. Rebooting it unchanged")
            reboot(fid)
            continue
        return fid


def flash_id():
    """Flash ID of the one half in BOOTSEL; picotool --ser matches this on RP2040.

    Retries because udev grants access a moment after the device appears.
    """
    subprocess.run(["udevadm", "settle", "-t", "5"], capture_output=True)
    deadline = time.monotonic() + ACCESS_TIMEOUT
    while time.monotonic() < deadline:
        res = subprocess.run([PICOTOOL, "info", "-d"], capture_output=True, text=True)
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                key, _, value = line.strip().partition(":")
                if key == "flash id":
                    return value.strip().removeprefix("0x").upper()
            raise Abort("picotool info -d did not report a flash id")
        time.sleep(0.5)
    raise Abort("picotool cannot access the half in bootloader (permissions? see 60-picotool.rules)")


def reboot(fid):
    picotool("reboot", "-a", fid=fid)
    if not wait_until(lambda: not bootsel_devices(), APP_TIMEOUT):
        raise Abort("device stayed in bootloader mode after reboot")
    if not wait_until(app_present, APP_TIMEOUT):
        say("Warning: keyboard not seen on USB after reboot")


def sparse_uf2(image, out):
    """Copy a UF2 without its blank (all 0xFF) blocks; returns blocks kept.

    A full-flash backup is 16 MB, nearly all blank. Writing only the data
    blocks after an erase gives the same flash in seconds.
    """
    data = image.read_bytes()
    blocks = []
    for i in range(0, len(data), UF2_BLOCK):
        block = data[i:i + UF2_BLOCK]
        size = UF2_HEADER.unpack_from(block)[4]
        if block[32:32 + size] != b"\xff" * size:
            blocks.append(bytearray(block))
    for n, block in enumerate(blocks):
        start0, start1, flags, addr, size, _, _, family = UF2_HEADER.unpack_from(block)
        UF2_HEADER.pack_into(block, 0, start0, start1, flags, addr, size, n, len(blocks), family)
    out.write_bytes(b"".join(blocks))
    return len(blocks)


def erase_firmware_region(fid):
    say("Erasing ...")
    start, end = FIRMWARE_REGION
    picotool("erase", "-r", hex(start), hex(end), fid=fid)


def write_image(fid, image, erase=False):
    if erase:
        erase_firmware_region(fid)
    say(f"Writing {image.name} ...")
    picotool("load", "-v", str(image), fid=fid)


def restore_image(fid, image):
    """Bring a half back to a full-flash backup: erase, then write its data blocks."""
    with tempfile.TemporaryDirectory() as tmp:
        sparse = Path(tmp) / image.name
        sparse_uf2(image, sparse)
        erase_firmware_region(fid)
        say(f"Writing {image.name} ...")
        picotool("load", "-v", str(sparse), fid=fid)


def parse_sides(value):
    sides = [s.strip() for s in value.split(",") if s.strip()]
    for s in sides:
        if s not in SIDES:
            raise argparse.ArgumentTypeError(f"unknown side {s!r}, expected {', '.join(SIDES)}")
    return sides


def finish(last_side):
    if last_side != "left":
        prompt("USB cable back in LEFT half")
    say("Done")


def do_backup(sides, label=None, root=BACKUP_ROOT):
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    out = root / (f"{stamp}-{label}" if label else stamp)
    out.mkdir(parents=True)
    manifest = {"created": stamp, "sides": {}}
    say(f"Backup to {out}")
    for side in sides:
        fid = enter_bootsel(side)
        (out / f"{side}-info.txt").write_text(picotool("info", "-a", fid=fid, capture=True))
        image = out / f"{side}.uf2"
        say("Reading flash ...")
        picotool("save", "-a", "-v", str(image), fid=fid)
        digest = sha256(image)
        manifest["sides"][side] = {"file": image.name, "sha256": digest, "flash_id": fid}
        (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
        reboot(fid)
    return out


def do_restore(backup, sides):
    manifest = json.loads((backup / "manifest.json").read_text())
    missing = [s for s in sides if s not in manifest["sides"]]
    if missing:
        raise Abort(f"backup has no image for {', '.join(missing)}")
    for side in sides:
        entry = manifest["sides"][side]
        image = backup / entry["file"]
        if sha256(image) != entry["sha256"]:
            raise Abort(f"{image} does not match its recorded checksum")
    say(f"Restore from {backup}")
    for side in sides:
        entry = manifest["sides"][side]
        fid = enter_bootsel(side, expect_id=entry["flash_id"])
        restore_image(fid, backup / entry["file"])
        reboot(fid)


def cmd_backup(args):
    do_backup(args.sides, args.label)
    finish(args.sides[-1])


def cmd_restore(args):
    do_restore(Path(args.backup).expanduser(), args.sides)
    finish(args.sides[-1])


def cmd_flash(args):
    image = Path(args.firmware).expanduser()
    if not image.is_file():
        raise Abort(f"{image} not found")
    if set(args.sides) != set(SIDES):
        if not confirm("Halves must run the same firmware. Flash only " + ", ".join(args.sides) + "?"):
            raise Abort("cancelled")
    say(f"Flash {image.name}" + (" (erasing stored settings)" if args.erase else ""))
    for side in args.sides:
        fid = enter_bootsel(side)
        write_image(fid, image, erase=args.erase)
        reboot(fid)
    finish(args.sides[-1])


def vial_dump(out):
    script = TOOLS_DIR / "vial_dump.py"
    res = subprocess.run([sys.executable, str(script), str(out)])
    if res.returncode != 0:
        raise Abort("Vial layout dump failed")


def cmd_vial_dump(args):
    vial_dump(Path(args.out).expanduser())


def cmd_drill(args):
    backup = do_backup(list(SIDES), "drill")
    do_restore(backup, list(SIDES))
    prompt("USB cable back in LEFT half")
    if args.expect_vil:
        expected = Path(args.expect_vil).expanduser()
        out = backup / "after-restore.vil"
        if not wait_until(app_present, APP_TIMEOUT):
            raise Abort("keyboard not found on USB")
        vial_dump(out)
        if sha256(out) != sha256(expected):
            raise Abort(f"layout differs from {expected}; compare {out}")
        say("Layout matches")
    say(f"Drill passed: {backup}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    all_sides = ",".join(SIDES)

    p = sub.add_parser("backup", help="full-flash image of each half")
    p.add_argument("--sides", type=parse_sides, default=list(SIDES), help=f"default {all_sides}")
    p.add_argument("--label", help="suffix for the backup directory")
    p.set_defaults(func=cmd_backup)

    p = sub.add_parser("restore", help="write a backup back to its halves")
    p.add_argument("backup", help="backup directory (contains manifest.json)")
    p.add_argument("--sides", type=parse_sides, default=list(SIDES), help=f"default {all_sides}")
    p.set_defaults(func=cmd_restore)

    p = sub.add_parser("flash", help="flash one firmware image to both halves")
    p.add_argument("firmware", help=".uf2 firmware file")
    p.add_argument("--sides", type=parse_sides, default=list(SIDES), help=f"default {all_sides}")
    p.add_argument("--erase", action="store_true", help="erase all flash first, clearing stored settings")
    p.set_defaults(func=cmd_flash)

    p = sub.add_parser("drill", help="backup then restore, to prove recovery works")
    p.add_argument("--expect-vil", help="Vial layout file the keyboard must still match afterwards")
    p.set_defaults(func=cmd_drill)

    p = sub.add_parser("vial-dump", help="save the live Vial layout")
    p.add_argument("out", help="output .vil file")
    p.set_defaults(func=cmd_vial_dump)

    args = parser.parse_args()
    if args.cmd != "vial-dump" and not shutil.which(PICOTOOL):
        sys.exit(f"kbflash: {PICOTOOL} not found")
    try:
        args.func(args)
    except Abort as e:
        say(f"\nkbflash: stopped: {e}")
        if bootsel_devices():
            say("A half is still in bootloader (safe). Bring it back: picotool reboot, or kbflash restore DIR")
        sys.exit(1)
    except KeyboardInterrupt:
        say("\nkbflash: interrupted")
        if bootsel_devices():
            say("A half is still in bootloader (safe). Bring it back: picotool reboot, or kbflash restore DIR")
        sys.exit(130)


if __name__ == "__main__":
    main()
