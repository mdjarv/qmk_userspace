[Unit]
Description=Feed the Sofle's left OLED (kbscreen)
After=pipewire-pulse.service

[Service]
# make screen-install fills in the repo's script directory and the preview address
ExecStart=%h/.local/bin/kbscreen -scripts @SCRIPTS@ -preview @PREVIEW@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
